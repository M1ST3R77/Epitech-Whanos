FROM maven:3.9.9-eclipse-temurin-21 as builder

SHELL ["/bin/bash", "-c"]

WORKDIR /app

COPY . /app

RUN mvn -f /app/pom.xml compile

RUN mvn -f /app/pom.xml package

RUN cp /app/target/app.jar .

RUN rm -rf /app


FROM openjdk:21-jdk

RUN apk add --no-cache bash

SHELL ["/bin/bash", "-c"]

WORKDIR /app

COPY --from=builder /app /app

CMD ["java", "-jar", "app.jar"]